{
  "name": "cafe-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit -p studio/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "studio:dev": "pnpm --filter cafe-demo-studio dev",
    "studio:build": "pnpm --filter cafe-demo-studio build",
    "studio:deploy": "pnpm --filter cafe-demo-studio deploy",
    "demo:restore": "node scripts/restore-demo.ts"
  },
  "dependencies": {
    "astro": "7.4.2",
    "libphonenumber-js": "1.13.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
