---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { getContent } from '../lib/content';
const content = await getContent();
---
<Layout title="Inicio" description="Bruma: una cafetería ficticia y una experiencia web de demostración inspirada en la calma costera." content={content}>
  <section class="hero shell">
    <div><p class="eyebrow">Una pausa imaginada en Constitución</p><h1>{content.homeTitle}</h1><p class="lead">{content.homeIntro}</p><div class="actions"><a class="button" href="/menu/">Explorar el menú <span aria-hidden="true">↗</span></a><a class="text-link" href="/reservas/">Probar una solicitud →</a></div><p class="small">Café ficticio. Una experiencia real de diseño.</p></div>
    <Scene image={content.heroImage} eager />
  </section>
  <div class="values"><div class="shell"><span>Café & conversación</span><span>Sabores de ejemplo</span><span>Una web para imaginar</span></div></div>
  <section class="shell section story"><p class="eyebrow">El espíritu de Bruma</p><div><h2>{content.storyTitle}</h2><p class="lead">{content.storyBody}</p><a class="text-link" href="/grupos-y-eventos/">Compartir un momento →</a></div></section>
  <section class="section tinted"><div class="shell"><p class="eyebrow">Lo que podríamos compartir</p><h2>Pequeños favoritos, grandes pausas.</h2><div class="cards">{content.products.slice(0, 3).map((product, index) => <article class="card"><span class="card-number" aria-hidden="true">0{index + 1}</span><h3>{product.name}</h3><p>{product.description}</p><span class="price">{new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP' }).format(product.price)} <small>de ejemplo</small></span></article>)}</div><a class="text-link" href="/menu/">Ver todos los sabores →</a></div></section>
  <section class="shell section"><p class="eyebrow">Voces imaginadas</p><h2>Una idea que invita a quedarse.</h2><div class="quotes">{content.reviews.map((review) => <figure><figcaption class="badge">Opinión ficticia · Demostración</figcaption><blockquote>“{review.quote}”</blockquote></figure>)}</div></section>
</Layout>
